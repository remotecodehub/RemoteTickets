<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <MudPaper Class="pa-6" Elevation="8">
        <MudStack Spacing="2" AlignItems="AlignItems.Center">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="components-reconnect-first-attempt-visible" />
            <MudText Typo="Typo.h6" Class="components-reconnect-first-attempt-visible">Rejoining the server...</MudText>
            <MudText Typo="Typo.body1" Class="components-reconnect-repeated-attempt-visible">
                Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
            </MudText>
            <MudText Typo="Typo.body1" Class="components-reconnect-failed-visible">
                Failed to rejoin. Please retry or reload the page.
            </MudText>
            <MudButton id="components-reconnect-button" Variant="Variant.Filled" Color="Color.Primary" Class="components-reconnect-failed-visible">
                Retry
            </MudButton>
            <MudText Typo="Typo.body1" Class="components-pause-visible">The session has been paused by the server.</MudText>
            <MudText Typo="Typo.body1" Class="components-resume-failed-visible">Failed to resume the session. Please retry or reload the page.</MudText>
            <MudButton id="components-resume-button" Variant="Variant.Filled" Color="Color.Primary" Class="components-pause-visible components-resume-failed-visible">
                Resume
            </MudButton>
        </MudStack>
    </MudPaper>
</dialog>
