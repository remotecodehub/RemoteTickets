@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">RemoteTickets</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Tenant-aware ticket management</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="DrawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<MudPaper id="blazor-error-ui" Class="pa-4 ma-4" Elevation="4" Style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:2000;">
    <MudText>An unhandled error has occurred.</MudText>
    <MudLink Href=".">Reload</MudLink>
    <MudIconButton Icon="@Icons.Material.Filled.Close" />
</MudPaper>

@code {
    private bool DrawerOpen = true;

    private void ToggleDrawer() => DrawerOpen = !DrawerOpen;
}
