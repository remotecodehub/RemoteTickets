@page "/{TenantId}/setup"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Tenant setup</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">Tenant setup</MudText>
        <MudText Typo="Typo.body1" Class="mb-6">
            Tenant <strong>@TenantId</strong> is not ready for normal operations. Run the database validation and complete setup.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" StartIcon="@Icons.Material.Filled.Verified" OnClick="CompleteAsync">
            @(Busy ? "Validating..." : "Validate and complete setup")
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudAlert Severity="@(SetupSucceeded ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mt-4">
                @Message
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string TenantId { get; set; } = string.Empty;
    private bool Busy;
    private bool SetupSucceeded;
    private string Message = string.Empty;

    private async Task CompleteAsync()
    {
        Busy = true;
        SetupSucceeded = false;
        Message = string.Empty;
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);
            var response = await client.PostAsync($"api/v1/{Uri.EscapeDataString(TenantId)}/setup/complete", null);
            if (response.IsSuccessStatusCode)
            {
                SetupSucceeded = true;
                Message = "Tenant setup completed.";
                Navigation.NavigateTo($"/{TenantId}", true);
                return;
            }
            Message = await response.Content.ReadAsStringAsync();
        }
        catch (Exception exception)
        {
            Message = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
