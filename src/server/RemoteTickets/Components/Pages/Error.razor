@page "/Error"

<PageTitle>Error</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        <MudText Typo="Typo.h5">An error occurred while processing your request.</MudText>
        <MudText Typo="Typo.body1">Please retry the operation or reload the application.</MudText>
    </MudAlert>

    @if (ShowRequestId)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.body2">Request ID</MudText>
            <MudText Typo="Typo.body1"><code>@RequestId</code></MudText>
        </MudPaper>
    }

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">
            Development details are intentionally hidden from deployed applications because exceptions can expose sensitive information.
        </MudText>
    </MudAlert>
</MudContainer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
        => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
